# ---------------------------------------------------------------------------
# Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console          # json in production

# --- Datastores ------------------------------------------------------------
# Inside Docker Compose these resolve to the service names.
# Connect as app_rw, NOT the owner/superuser. A superuser bypasses Row Level
# Security entirely and silently -- see docs/tenant-isolation.md.
DATABASE_URL=postgresql+asyncpg://app_rw:app_rw@postgres:5432/agentdb
REDIS_URL=redis://redis:6379/0

# --- Model server ----------------------------------------------------------
# Ollama normally runs on a SEPARATE machine (your GPU box). The backend only
# knows this URL; it never inspects local hardware and never picks a model for
# you. Point it at whatever serves your models:
#   same machine as Docker : http://host.docker.internal:11434
#   another machine on LAN : http://192.168.1.50:11434
#   private tunnel         : https://ollama.internal.example.com
# Never expose Ollama publicly without auth in front of it -- it has none.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FAST_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBEDDING_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_API_KEY=                 # only if behind an authenticating proxy

# Embedding dimension. MUST match the model above (nomic-embed-text = 768).
# It is baked into the vector column at migration time; changing it later is a
# documented re-embedding procedure, not an env edit. See docs/providers.md.
EMBEDDING_DIM=768
EMBEDDING_PROVIDER=default

# --- Cloud providers (all optional) ----------------------------------------
# Any provider without credentials is skipped at startup. The whole system runs
# on your Ollama server alone.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GROQ_ENABLED=true

# A remote vLLM / llama.cpp / LM Studio endpoint:
# VLLM_ENABLED=true
# VLLM_BASE_URL=http://10.0.0.5:8000/v1
# VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Security --------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECURITY__JWT_SECRET=change-me-in-production
SECURITY__ACCESS_TOKEN_TTL_S=1800
SECURITY__CORS_ORIGINS=["http://localhost:3000"]

# --- Ingestion -------------------------------------------------------------
OCR__PROVIDER=tesseract         # tesseract | noop
OCR__LANGUAGES=["eng"]
OCR__DPI=300

STORAGE__PROVIDER=local         # local | s3 | memory
STORAGE__LOCAL_PATH=/data/storage
STORAGE__MAX_UPLOAD_BYTES=52428800
# Photos go straight to OCR. Drop the image types to turn that off.
STORAGE__ALLOWED_MIME_TYPES=["application/pdf","text/plain","text/markdown","image/png","image/jpeg","image/webp","image/tiff"]
# STORAGE__BUCKET=
# STORAGE__REGION=us-east-1
# STORAGE__ENDPOINT_URL=http://minio:9000
# STORAGE__ACCESS_KEY_ID=
# STORAGE__SECRET_ACCESS_KEY=

QUEUE__PROVIDER=redis_streams
QUEUE__MAX_ATTEMPTS=3
QUEUE__VISIBILITY_TIMEOUT_MS=300000

# --- Retrieval -------------------------------------------------------------
RETRIEVAL__FUSION=rrf           # rrf | weighted
RETRIEVAL__RRF_K=60
RETRIEVAL__VECTOR_WEIGHT=0.6
RETRIEVAL__KEYWORD_WEIGHT=0.4
RETRIEVAL__TOP_K=8
RETRIEVAL__CANDIDATE_K=50
RETRIEVAL__LOCATION_BOOST=1.02

CHUNKING__TARGET_TOKENS=512
CHUNKING__MAX_TOKENS=768
CHUNKING__OVERLAP_TOKENS=64

CONTEXT__MAX_CONTEXT_TOKENS=4000
AGENT__MAX_ITERATIONS=4
AGENT__DEADLINE_S=90
